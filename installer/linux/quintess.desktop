[Desktop Entry]
Type=Application
Name=Quintess
GenericName=PDF Reader and Editor
Comment=Read, edit, sign, redact and fill PDF files, privately and offline
Exec=quintess %F
TryExec=quintess
Icon=quintess
Terminal=false
Categories=Office;Viewer;Graphics;
MimeType=application/pdf;application/x-pdf;
Keywords=PDF;edit;sign;redact;form;OCR;annotate;
StartupNotify=true
StartupWMClass=quintess
